rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Identify the platform owner/admin via email
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "rajhazarika29@gmail.com";
    }

    // Check if user is a teacher
    // We check either isAdmin OR if the user has the teacher role in their document.
    // To avoid recursion in the user GET rule, we use this carefully.
    function isTeacher() {
      return isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return (data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['student', 'teacher'] &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 256)) &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (data.rollNo == null || (data.rollNo is string && data.rollNo.size() <= 50)) &&
             (data.idCardData == null || (data.idCardData is string && data.idCardData.size() <= 10000000)) &&
             (data.idCardUploadedAt == null || data.idCardUploadedAt is string) &&
             (data.fullName == null || (data.fullName is string && data.fullName.size() <= 256)) &&
             (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (data.dateOfBirth == null || (data.dateOfBirth is string && data.dateOfBirth.size() <= 32)) &&
             (data.address == null || (data.address is string && data.address.size() <= 1024)) &&
             (data.emergencyContact == null || (data.emergencyContact is string && data.emergencyContact.size() <= 50)) &&
             (data.verificationStatus == null || data.verificationStatus in ['pending', 'verified', 'rejected']) &&
             (data.updatedAt == null || data.updatedAt is string || data.updatedAt is timestamp);
    }

    function isValidAttendance(data) {
      return data.studentUid is string && data.studentUid.size() <= 128 &&
             data.studentName is string && data.studentName.size() <= 256 &&
             data.rollNo is string && data.rollNo.size() <= 50 &&
             data.status in ['present', 'absent'];
    }

    function isValidLesson(data) {
      return data.title is string && data.title.size() <= 256 &&
             data.description is string && data.description.size() <= 1024 &&
             data.teacherUid is string && data.teacherUid == request.auth.uid &&
             data.modules is list && data.modules.size() <= 50;
    }

    // --- Collection Routes ---

    match /users/{userId} {
      // Allow user to get their own record or admins/teachers to get any record.
      // We check isAdmin first for performance and to potentially bypass the need for a document read.
      allow get: if isOwner(userId) || isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      
      // Allow listing if teacher or if it's your own record.
      allow list: if isAdmin() || (isSignedIn() && (resource.data.uid == request.auth.uid)) || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      
      allow create: if isOwner(userId) && isValidId(userId);
                      
      allow update: if isOwner(userId) && 
                      isValidId(userId) &&
                      isValidUser(incoming()) &&
                      (
                        incoming().diff(existing()).affectedKeys().hasOnly([
                          'displayName', 'photoURL', 'rollNo', 'idCardData', 
                          'idCardUploadedAt', 'lastLogin', 'email', 'fullName',
                          'phoneNumber', 'dateOfBirth', 'address', 'emergencyContact',
                          'updatedAt', 'verificationStatus'
                        ])
                      );
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == existing().studentUid) || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      
      allow create: if isVerified() && (isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && 
                    isValidId(attendanceId) && isValidAttendance(incoming());
                    
      allow update: if isVerified() && (isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && 
                    isValidId(attendanceId) && isValidAttendance(incoming()) && incoming().studentUid == existing().studentUid;
                    
      allow delete: if (isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && isValidId(attendanceId);
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || (isVerified() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && isValidId(courseId);
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && (isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && 
                    isValidId(lessonId) && isValidLesson(incoming());
      allow update: if isVerified() && (isAdmin() || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && 
                    isValidId(lessonId) && isValidLesson(incoming()) && incoming().teacherUid == existing().teacherUid;
      allow delete: if (isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')) && isValidId(lessonId);
    }
    
    match /test/{docId} {
       allow get: if true;
       allow write: if false;
    }
  }
}
